	partition dim_date = m
		mode: import
		source = ```
			let
			    Origen = PostgreSQL.Database(Servidor, BaseDeDatos),
			    Tabla = Origen{[Schema = "gold", Item = "dim_date"]}[Data],
			    Filtro = Table.SelectRows(Tabla, each [is_historical] = true),
			    Columnas = Table.SelectColumns(Filtro, {"date_key", "calendar_date", "year", "quarter", "month", "month_name", "year_month", "iso_week", "day", "day_of_week", "day_name", "is_weekend"}),
			    Tipos = Table.TransformColumnTypes(Columnas, {{"date_key", Int64.Type}, {"calendar_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"iso_week", Int64.Type}, {"day", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"is_weekend", type logical}})
			in
			    Tipos
			```

	annotation PBI_ResultType = Table
