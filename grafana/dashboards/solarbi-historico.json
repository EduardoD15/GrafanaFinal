        "uid": "solarbi-pg"
      },
      "description": "OpenCEM historico: filas reales del archivo con is_simulated=false. La ETL agrega la energia solar estimada por dia e inversor.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "kwatth"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', measured_at) AS \"time\", 'Inversor ' || inverter_id AS metric, sum(solar_kwh_interval) AS value FROM gold.fact_energy_reading WHERE NOT is_simulated AND $__timeFilter(measured_at) AND inverter_id IN (${inverter:csv}) GROUP BY 1, inverter_id ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Generacion solar historica OpenCEM (kWh/dia)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "solarbi-pg"
      },
