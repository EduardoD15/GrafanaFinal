          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', measured_at) AS \"time\", 'Inversor ' || inverter_id AS metric, sum(co2_avoided_kg_interval) AS value FROM gold.fact_energy_reading WHERE NOT is_simulated AND $__timeFilter(measured_at) AND inverter_id IN (${inverter:csv}) GROUP BY 1, inverter_id ORDER BY 1",
