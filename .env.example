POSTGRES_DB=solarbi
POSTGRES_USER=solarbi
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_LOCAL
POSTGRES_HOST_PORT=5432
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA_LOCAL
# usuario de solo lectura (rol bi_reader) que usan Power BI y Grafana
BI_READER_USER=solarbi_reader
BI_READER_PASSWORD=CAMBIAR_LECTURA_LOCAL
# factor del SIN para inventarios de GEI, ano 2024: 0.220 tCO2eq/MWh = 0.220 kg/kWh (Resolucion UPME 085 de 2026)
CO2_FACTOR_KG_PER_KWH=0.220
# tarifa de referencia, EPM estrato 3, factura de diciembre de 2025 (ajustar con la factura de la universidad)
TARIFF_COP_PER_KWH=790.49
SIMULATOR_INTERVAL_MS=1000
# horas de sol del simulador; -5 hace que amanezca a la hora de Colombia
SIMULATOR_DAYLIGHT_OFFSET_HOURS=8
# limite para integrar energia entre dos lecturas (la cadencia de la fuente va de 12 s a 6 min)
MAX_INTERVAL_SECONDS=900
# ventana opcional de la carga (dias del sitio); vacio carga todo el ano
ETL_START_DATE=
ETL_END_DATE=
